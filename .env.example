# =========================================================================
# ecoflow_bridge.py -- MQTT bridge + Telegram alerts (runs on the Pi)
# Uses the EcoFlow *app* account, not the developer API.
# =========================================================================
ECOFLOW_EMAIL=you@example.com
ECOFLOW_PASSWORD=your_ecoflow_app_password
ECOFLOW_APP_DOMAIN=api.ecoflow.com
HTTP_PORT=8080
# Bind address for /status. Use 127.0.0.1 on a host that should not serve it.
HTTP_HOST=0.0.0.0
# Set to 0 on a host that should only serve /status (no Telegram alerts).
# The Telegram vars below are then optional.
TELEGRAM_ENABLED=1

# A source change (mains <-> battery) must hold this long before alerting.
CONFIRM_SEC=15

# Farm internet monitor: ping this public IP and send Telegram alerts when it
# stops answering / comes back. Leave empty to disable. Set it only on the host
# that owns the Telegram alerts (the VPS), never on the Pi behind the same outages.
FARM_WAN_HOST=
# Pinged when the farm does not answer; if it fails too, the problem is ours - no alert.
WAN_CONTROL_HOST=1.1.1.1
WAN_INTERVAL_SEC=15
# Consecutive failed checks before "down", successful ones before "back".
WAN_DOWN_AFTER=4
WAN_UP_AFTER=2

# No decoded MQTT message for this long -> drop the session and log in again.
# The TCP socket can stay ESTABLISHED long after delivery has died, so this
# watches actual messages rather than the connection.
STALL_RECONNECT_SEC=300

# No decoded MQTT message for this long -> Telegram alert. Longer than
# STALL_RECONNECT_SEC so a stall a single reconnect fixes stays quiet.
STALL_ALERT_SEC=900


# =========================================================================
# ecoflow_monitor.py -- polling monitor (not currently deployed)
# =========================================================================
# EcoFlow Developer API credentials (https://developer-eu.ecoflow.com)
ECOFLOW_BASE_URL=https://api-e.ecoflow.com
ECOFLOW_ACCESS_KEY=your_access_key
ECOFLOW_SECRET_KEY=your_secret_key
ECOFLOW_DEVICE_SN=your_device_serial_number

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Device / behaviour
DEVICE_NAME=The Farm Internet
POLL_INTERVAL_SECONDS=30

# Grid-presence detection. Confirm exact keys with:  python ecoflow_monitor.py --discover
# GRID_FIELD is the quota key that reflects AC/grid input; grid is "present"
# when its value exceeds GRID_THRESHOLD.
GRID_FIELD=inv.acInVol
GRID_THRESHOLD=1000

# Temperature reporting. Some models report deci-degrees; set TEMP_DIVISOR=10 then.
TEMP_FIELD=bms_bmsStatus.temp
TEMP_DIVISOR=1

# Debounce / reliability
STATE_CONFIRM_COUNT=2
API_FAIL_ALERT_COUNT=10
